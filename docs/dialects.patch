@@ -0,0 +1,129 @@
+// American dialects the scoring can aim for (a proposal: docs/dialects.md).
+//
+// With a dialect picked, its own way of saying a word is the target: it scores green. The General American way
+// still scores, but no better than yellow, with a note that it was "the General American way". Anything else is
+// graded as usual. With General American (the default) nothing changes.
+//
+// The scoring model hears 38 sounds (phones.js), so a dialect can only be scored where it uses a different one
+// of those sounds, or leaves one out. Each rule looks at one sound of a word, with its neighbors, and can say:
+//   - use: the model sounds this dialect says there instead, or
+//   - drop: this dialect leaves the sound out.
+// Each dialect also has notes for the learner: what's different, a few words to try, and a tip.
+
+const VOWELS = new Set([
+  "AA", "AE", "AH", "AO", "AW", "AY", "EH", "ER", "EY", "IH", "IY", "OW", "OY", "UH", "UW",
+]);
+const VOICED = new Set([
+  "B", "D", "G", "V", "DH", "Z", "ZH", "JH", "M", "N", "NG", "L", "R", "W", "Y",
+]);
+
+const isVowel = (p) => VOWELS.has(p);
+const last = (phones, i) => i === phones.length - 1;
+
+// Each feature is one difference from General American: a rule for which sounds it changes, and a note for the
+// learner (what's different, a few words to try, and a tip).
+export const FEATURES = {
+  // pen like pin: the e before m or n said like the i in "pin".
+  pinPen: {
+    rule: (phones, i) => (phones[i] === "EH" && (phones[i + 1] === "N" || phones[i + 1] === "M") ? { use: ["ɪ"] } : null),
+    note: {
+      title: "pen sounds like pin",
+      words: ["pen", "ten", "when", "remember"],
+      tip: "Before m or n, say the e like the i in pin.",
+    },
+  },
+  // time like "tahm": one long "ah" for the i, except before a voiceless sound (right, ice, like), where most
+  // Southern speakers keep the slide.
+  flatI: {
+    rule: (phones, i) => {
+      const next = phones[i + 1];
+      return phones[i] === "AY" && (last(phones, i) || VOICED.has(next) || isVowel(next)) ? { use: ["ɑ"] } : null;
+    },
+    note: {
+      title: "time sounds like \"tahm\"",
+      words: ["time", "ride", "my", "fire"],
+      tip: "Say the i as one long \"ah\", without sliding up to \"ee\". Before t, s, or k (right, ice, like), keep the slide.",
+    },
+  },
+  // car like "cah": no r after a vowel unless another vowel follows (carry keeps its r).
+  noR: {
+    rule: (phones, i) =>
+      phones[i] === "R" && i > 0 && isVowel(phones[i - 1]) && (last(phones, i) || !isVowel(phones[i + 1])) ? { drop: true } : null,
+    note: {
+      title: "No r after a vowel",
+      words: ["car", "park", "four", "here"],
+      tip: "After a vowel, leave the r out and stretch the vowel a little: car sounds like \"cah\". Keep the r when a vowel comes next, as in carry and story.",
+    },
+  },
+  // water like "watah": the r-colored vowel becomes a plain "uh", unless a vowel follows.
+  erToUh: {
+    rule: (phones, i) => (phones[i] === "ER" && (last(phones, i) || !isVowel(phones[i + 1])) ? { use: ["ə"] } : null),
+    note: {
+      title: "\"er\" becomes \"uh\"",
+      words: ["water", "better", "teacher", "bird"],
+      tip: "Say the end of water like the \"uh\" in about: \"watah\".",
+    },
+  },
+  // down like "dahn": one long "ah" for the "ow".
+  flatOw: {
+    rule: (phones, i) => (phones[i] === "AW" ? { use: ["ɑ"] } : null),
+    note: {
+      title: "down sounds like \"dahn\"",
+      words: ["down", "house", "out", "town"],
+      tip: "Say the \"ow\" as one long \"ah\", without sliding to \"oo\": downtown sounds like \"dahntahn\".",
+    },
+  },
+  // bag like "bayg": the a before g or ng said like the a in "bake".
+  bagRaising: {
+    rule: (phones, i) => (phones[i] === "AE" && (phones[i + 1] === "G" || phones[i + 1] === "NG") ? { use: ["eɪ"] } : null),
+    note: {
+      title: "bag sounds like \"bayg\"",
+      words: ["bag", "flag", "dragon", "thank"],
+      tip: "Before g or ng, say the a like the a in bake.",
+    },
+  },
+};
+
+export const DIALECTS = {
+  general: { name: "General American", about: "The accent of most national news, and of the model voice.", features: [] },
+  southern: { name: "Southern", about: "From Texas to Georgia to Tennessee.", features: ["pinPen", "flatI"] },
+  boston: { name: "Boston", about: "Eastern New England.", features: ["noR", "erToUh"] },
+  newYork: { name: "New York City", about: "New York City and nearby.", features: ["noR", "erToUh"] },
+  pittsburgh: { name: "Pittsburgh", about: "Western Pennsylvania.", features: ["flatOw"] },
+  upperMidwest: {
+    name: "Upper Midwest and Pacific Northwest",
+    about: "Minnesota, Wisconsin, Washington, and Oregon.",
+    features: ["bagRaising"],
+  },
+};
+
+export const DEFAULT_DIALECT = "general";
+
+function dialectOf(id) {
+  const d = DIALECTS[id];
+  if (!d) throw new Error(`Unknown dialect: ${id}`);
+  return d;
+}
+
+// What a dialect changes for one word, sound by sound: { use: [...] }, { drop: true }, or {}, plus the feature
+// that made the change. phones are CMU sounds, with or without stress numbers.
+// changes(["K", "AA", "R"], "boston") → [{}, {}, { drop: true, feature: "noR" }]
+export function changes(phones, dialect = DEFAULT_DIALECT) {
+  const d = dialectOf(dialect);
+  const bare = phones.map((p) => p.replace(/[0-9]/g, ""));
+  return bare.map((_, i) => {
+    for (const feature of d.features) {
+      const r = FEATURES[feature].rule(bare, i);
+      if (r) return { ...r, feature };
+    }
+    return {};
+  });
+}
+
+// The notes for one word in one dialect: one per feature that changes any of its sounds, in order.
+// notesFor(["W", "AO", "T", "ER"], "boston") → [{ title: "\"er\" becomes \"uh\"", words: [...], tip: "..." }]
+export function notesFor(phones, dialect = DEFAULT_DIALECT) {
+  const seen = [];
+  for (const c of changes(phones, dialect)) if (c.feature && !seen.includes(c.feature)) seen.push(c.feature);
+  return seen.map((f) => FEATURES[f].note);
+}
