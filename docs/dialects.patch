+// American dialects the scoring can allow for (a proposal: docs/dialects.md).
+//
+// The scoring model hears 38 sounds (phones.js), so a dialect can only be told apart where it uses a
+// different one of those sounds, or drops one. Each rule looks at one sound of a word, with its neighbors,
+// and can:
+//   - add sounds that also count as right there (`also`), or
+//   - mark the sound as one this dialect may leave out (`optional`).
+// The General American way of saying a word always still counts as right. A dialect only stops its own
+// way of saying a word from being marked as a mistake.
+//
+// Dialect differences the model can't hear (vowels that only shift a little, like the Northern Cities shift
+// around Chicago or the California vowel shift) aren't here. For those regions the scoring is the same as
+// General American.
+
+const VOWELS = new Set([
+  "AA", "AE", "AH", "AO", "AW", "AY", "EH", "ER", "EY", "IH", "IY", "OW", "OY", "UH", "UW",
+]);
+const VOICED = new Set([
+  "B", "D", "G", "V", "DH", "Z", "ZH", "JH", "M", "N", "NG", "L", "R", "W", "Y",
+]);
+
+const isVowel = (p) => VOWELS.has(p);
+const last = (phones, i) => i === phones.length - 1;
+
+// pin and pen sound the same: the e before m or n is said like the i in "pin".
+function pinPen(phones, i) {
+  if (phones[i] === "EH" && (phones[i + 1] === "N" || phones[i + 1] === "M")) return { also: ["ɪ"] };
+}
+
+// The "i" in time, ride, my, and fire said as one long "ah" instead of sliding "ah-ee", except before a
+// voiceless sound (right, ice), where most Southern speakers keep the slide.
+function flatI(phones, i) {
+  const next = phones[i + 1];
+  if (phones[i] === "AY" && (last(phones, i) || VOICED.has(next) || isVowel(next))) return { also: ["ɑ"] };
+}
+
+// No r after a vowel unless another vowel follows (car → "cah", water → "watah"; carry keeps its r).
+function noR(phones, i) {
+  const beforeConsonantOrEnd = last(phones, i) || !isVowel(phones[i + 1]);
+  if (phones[i] === "R" && i > 0 && isVowel(phones[i - 1]) && beforeConsonantOrEnd) return { optional: true };
+  if (phones[i] === "ER" && beforeConsonantOrEnd) return { also: ["ə"] };
+}
+
+export const DIALECTS = {
+  general: {
+    name: "General American",
+    about: "The accent of most national news and of the model voice.",
+    rules: [],
+  },
+  southern: {
+    name: "Southern",
+    about: "pin and pen sound the same, and time sounds like \"tahm\".",
+    rules: [pinPen, flatI],
+  },
+  boston: {
+    name: "Boston",
+    about: "No r after a vowel: car sounds like \"cah\".",
+    rules: [noR],
+  },
+  newYork: {
+    name: "New York City",
+    about: "No r after a vowel: water sounds like \"watah\".",
+    rules: [noR],
+  },
+};
+
+export const DEFAULT_DIALECT = "general";
+
+// What a dialect changes for one word: for each sound, extra model sounds that count as right, and whether
+// it may be left out. phones are CMU sounds without stress numbers.
+// allowances(["K", "AA", "R"], "boston") → [{ also: [] }, { also: [] }, { also: [], optional: true }]
+export function allowances(phones, dialect = DEFAULT_DIALECT) {
+  const d = DIALECTS[dialect];
+  if (!d) throw new Error(`Unknown dialect: ${dialect}`);
+  return phones.map((_, i) => {
+    const out = { also: [], optional: false };
+    for (const rule of d.rules) {
+      const r = rule(phones, i);
+      if (r?.also) out.also.push(...r.also.filter((s) => !out.also.includes(s)));
+      if (r?.optional) out.optional = true;
+    }
+    return out;
+  });
+}
