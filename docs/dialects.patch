diff --git a/tests/score/dialects.test.js b/tests/score/dialects.test.js
new file mode 100644
index 0000000..b846b0e
--- /dev/null
+++ b/tests/score/dialects.test.js
@@ -0,0 +1,145 @@
+// Dialects (a proposal, docs/dialects.md): what each one changes, its notes, and how scoring treats its own way
+// of saying a word (green) against the General American way (yellow). No model, no audio.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { changes, notesFor, DIALECTS, FEATURES } from "../../js/score/dialects.js";
+import { targets } from "../../js/score/phones.js";
+import { logSoftmax, readVocab, prepare, scoreWord } from "../../js/score/gop.js";
+
+const at = (phones, dialect, i) => targets(phones, dialect)[i];
+const drops = (phones, dialect) => targets(phones, dialect).map((t) => Boolean(t.drop));
+
+test("General American changes nothing", () => {
+  for (const word of [["P", "EH1", "N"], ["T", "AY1", "M"], ["K", "AA1", "R"], ["W", "AO1", "T", "ER0"], ["B", "AE1", "G"], ["D", "AW1", "N"]]) {
+    assert.deepEqual(targets(word, "general"), targets(word));
+    assert.ok(targets(word).every((t) => !t.drop && !t.general && !t.feature));
+    assert.deepEqual(notesFor(word), []);
+  }
+});
+
+test("an unknown dialect is an error", () => {
+  assert.throws(() => changes(["K"], "atlantis"), /Unknown dialect/);
+  assert.throws(() => notesFor(["K"], "atlantis"), /Unknown dialect/);
+});
+
+test("every dialect has a name, a line about it, and only real features", () => {
+  for (const d of Object.values(DIALECTS)) {
+    assert.ok(d.name && d.about);
+    for (const f of d.features) assert.ok(FEATURES[f], f);
+  }
+});
+
+test("every feature's note has a title, words to try, and a tip", () => {
+  for (const [name, f] of Object.entries(FEATURES)) {
+    assert.ok(f.note.title && f.note.tip, name);
+    assert.ok(f.note.words.length >= 3, name);
+  }
+});
+
+test("Southern: pen is said like pin, and General American's e is kept as general", () => {
+  assert.deepEqual(at(["P", "EH1", "N"], "southern", 1), { cmu: "EH", ok: ["ɪ"], general: ["ɛ"], feature: "pinPen" });
+  assert.deepEqual(at(["T", "EH1", "M", "P", "T"], "southern", 1).ok, ["ɪ"]);
+  assert.deepEqual(at(["B", "EH1", "D"], "southern", 1), { cmu: "EH", ok: ["ɛ"] }); // bed stays bed
+});
+
+test("Southern: time, ride, my, and fire get a flat ah; right keeps its slide", () => {
+  for (const w of [["T", "AY1", "M"], ["R", "AY1", "D"], ["M", "AY1"], ["F", "AY1", "ER0"]]) {
+    assert.deepEqual(at(w, "southern", 1).ok, ["ɑ"], w.join(" "));
+  }
+  assert.deepEqual(at(["R", "AY1", "T"], "southern", 1).ok, ["aɪ"]);
+});
+
+test("Boston and New York: no r after a vowel, and er becomes uh", () => {
+  for (const d of ["boston", "newYork"]) {
+    assert.deepEqual(drops(["K", "AA1", "R"], d), [false, false, true]); // car
+    assert.deepEqual(drops(["K", "AA1", "R", "D"], d), [false, false, true, false]); // card
+    assert.deepEqual(drops(["K", "AE1", "R", "IY0"], d), [false, false, false, false]); // carry keeps it
+    assert.deepEqual(drops(["R", "AY1", "T"], d), [false, false, false]); // a first r stays
+    assert.deepEqual(at(["W", "AO1", "T", "ER0"], d, 3), { cmu: "ER", ok: ["ə"], general: ["ɝ"], feature: "erToUh" });
+  }
+});
+
+test("Pittsburgh: down and house get a flat ah", () => {
+  assert.deepEqual(at(["D", "AW1", "N"], "pittsburgh", 1).ok, ["ɑ"]);
+  assert.deepEqual(at(["HH", "AW1", "S"], "pittsburgh", 1).ok, ["ɑ"]);
+});
+
+test("Upper Midwest and Pacific Northwest: bag and thank, but not bad", () => {
+  assert.deepEqual(at(["B", "AE1", "G"], "upperMidwest", 1).ok, ["eɪ"]);
+  assert.deepEqual(at(["TH", "AE1", "NG", "K"], "upperMidwest", 1).ok, ["eɪ"]);
+  assert.deepEqual(at(["B", "AE1", "D"], "upperMidwest", 1).ok, ["æ"]);
+});
+
+test("notes: one for each feature the word uses, in order", () => {
+  assert.deepEqual(notesFor(["W", "AO1", "T", "ER0"], "boston").map((n) => n.title), ["\"er\" becomes \"uh\""]);
+  assert.deepEqual(notesFor(["K", "AA1", "R", "T", "ER0"], "boston").length, 2); // carter: no r, and er
+  assert.deepEqual(notesFor(["P", "EH1", "N"], "boston"), []); // Boston doesn't change pen
+  assert.deepEqual(notesFor(["T", "AY1", "M"], "southern")[0], FEATURES.flatI.note);
+});
+
+// A tiny model: frames from a list like ["k", "k", "-", "ɑ"], where "-" is no sound. It always knows the tap
+// "ɾ", because t and d also count as said right with it (phones.js).
+function model(sounds) {
+  const vocab = { "[PAD]": 0, "|": 1, "[UNK]": 2 };
+  for (const s of [...sounds, "ɾ"]) vocab[s] ??= Object.keys(vocab).length;
+  const v = readVocab(vocab);
+  const frames = (list) => logSoftmax(list.map((x) => Object.keys(vocab).map((k) => (k === (x === "-" ? "[PAD]" : x) ? 8 : 0))));
+  return { v, prep: (list) => prepare(frames(list), v) };
+}
+const grades = (result) => result.map((r) => r.grade);
+
+test("pen in Southern: said like pin is green, said like General American's pen is yellow", () => {
+  const m = model(["p", "ɛ", "ɪ", "n"]);
+  const PEN = ["P", "EH1", "N"];
+  const asPin = scoreWord(m.prep(["p", "p", "-", "ɪ", "ɪ", "-", "n", "n"]), targets(PEN, "southern"), m.v);
+  assert.deepEqual(grades(asPin), ["green", "green", "green"]);
+  const asPen = scoreWord(m.prep(["p", "p", "-", "ɛ", "ɛ", "-", "n", "n"]), targets(PEN, "southern"), m.v);
+  assert.deepEqual(grades(asPen), ["green", "yellow", "green"]);
+  assert.equal(asPen[1].general, true);
+  assert.equal(asPen[1].heard, "ɛ");
+  // And in General American it's the other way round.
+  assert.deepEqual(grades(scoreWord(m.prep(["p", "p", "-", "ɛ", "ɛ", "-", "n", "n"]), targets(PEN), m.v)), ["green", "green", "green"]);
+  assert.equal(scoreWord(m.prep(["p", "p", "-", "ɪ", "ɪ", "-", "n", "n"]), targets(PEN), m.v)[1].grade, "red");
+});
+
+test("pen in Southern said with a sound that's neither: still red", () => {
+  const m = model(["p", "ɛ", "ɪ", "n", "æ"]);
+  const r = scoreWord(m.prep(["p", "p", "-", "æ", "æ", "-", "n", "n"]), targets(["P", "EH1", "N"], "southern"), m.v);
+  assert.equal(r[1].grade, "red");
+  assert.ok(!r[1].general);
+});
+
+const CAR = ["K", "AA1", "R"];
+
+test("car in Boston: without the r is green, with the r is yellow", () => {
+  const m = model(["k", "ɑ", "ɹ"]);
+  const without = scoreWord(m.prep(["k", "k", "-", "ɑ", "ɑ", "ɑ"]), targets(CAR, "boston"), m.v);
+  assert.deepEqual(grades(without), ["green", "green", "green"]);
+  assert.equal(without[2].dropped, true);
+  assert.equal(without[2].score, null);
+  const withR = scoreWord(m.prep(["k", "k", "-", "ɑ", "ɑ", "-", "ɹ", "ɹ"]), targets(CAR, "boston"), m.v);
+  assert.deepEqual(grades(withR), ["green", "green", "yellow"]);
+  assert.equal(withR[2].general, true);
+  assert.ok(!withR[2].dropped);
+});
+
+test("car in General American: without the r is red", () => {
+  const m = model(["k", "ɑ", "ɹ"]);
+  assert.equal(scoreWord(m.prep(["k", "k", "-", "ɑ", "ɑ", "ɑ"]), targets(CAR), m.v)[2].grade, "red");
+});
+
+test("each r is decided on its own: hardware with only the first r left out", () => {
+  const m = model(["h", "ɑ", "ɹ", "d", "w", "ɛ"]);
+  const said = ["h", "h", "-", "ɑ", "ɑ", "-", "d", "d", "-", "w", "w", "-", "ɛ", "ɛ", "-", "ɹ", "ɹ"];
+  const r = scoreWord(m.prep(said), targets(["HH", "AA1", "R", "D", "W", "EH2", "R"], "boston"), m.v);
+  assert.deepEqual(grades(r), ["green", "green", "green", "green", "green", "green", "yellow"]);
+  assert.equal(r[2].dropped, true);
+  assert.equal(r[6].general, true);
+});
+
+test("down in Pittsburgh: dahn is green, General American's down is yellow", () => {
+  const m = model(["d", "aʊ", "ɑ", "n"]);
+  const DOWN = ["D", "AW1", "N"];
+  assert.deepEqual(grades(scoreWord(m.prep(["d", "d", "-", "ɑ", "ɑ", "-", "n", "n"]), targets(DOWN, "pittsburgh"), m.v)), ["green", "green", "green"]);
+  assert.deepEqual(grades(scoreWord(m.prep(["d", "d", "-", "aʊ", "aʊ", "-", "n", "n"]), targets(DOWN, "pittsburgh"), m.v)), ["green", "yellow", "green"]);
+});
