diff --git a/tests/score/dialects.test.js b/tests/score/dialects.test.js
new file mode 100644
index 0000000..536af16
--- /dev/null
+++ b/tests/score/dialects.test.js
@@ -0,0 +1,89 @@
+// Dialects (a proposal, docs/dialects.md): which ways of saying a word each one allows, and how scoring treats a sound
+// a dialect may leave out. No model, no audio.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { allowances, DIALECTS } from "../../js/score/dialects.js";
+import { targets } from "../../js/score/phones.js";
+import { logSoftmax, readVocab, prepare, scoreWord } from "../../js/score/gop.js";
+
+const ok = (phones, dialect) => targets(phones, dialect).map((t) => t.ok);
+const optional = (phones, dialect) => targets(phones, dialect).map((t) => Boolean(t.optional));
+
+test("General American changes nothing", () => {
+  for (const word of [["P", "EH1", "N"], ["T", "AY1", "M"], ["K", "AA1", "R"], ["W", "AO1", "T", "ER0"]]) {
+    assert.deepEqual(targets(word, "general"), targets(word));
+    assert.ok(targets(word).every((t) => !t.optional));
+  }
+});
+
+test("an unknown dialect is an error", () => {
+  assert.throws(() => allowances(["K"], "atlantis"), /Unknown dialect/);
+});
+
+test("every dialect has a name and a plain sentence about it", () => {
+  for (const d of Object.values(DIALECTS)) {
+    assert.ok(d.name && d.about && Array.isArray(d.rules));
+  }
+});
+
+test("Southern: the e in pen and ten also counts as the i in pin", () => {
+  assert.deepEqual(ok(["P", "EH1", "N"], "southern")[1], ["ɛ", "ɪ"]);
+  assert.deepEqual(ok(["T", "EH1", "M", "P", "T"], "southern")[1], ["ɛ", "ɪ"]);
+  // Not before other sounds: bed stays bed.
+  assert.deepEqual(ok(["B", "EH1", "D"], "southern")[1], ["ɛ"]);
+});
+
+test("Southern: time and ride can be said with a flat ah, right keeps its slide", () => {
+  assert.deepEqual(ok(["T", "AY1", "M"], "southern")[1], ["aɪ", "ɑ"]);
+  assert.deepEqual(ok(["R", "AY1", "D"], "southern")[1], ["aɪ", "ɑ"]);
+  assert.deepEqual(ok(["M", "AY1"], "southern")[1], ["aɪ", "ɑ"]);
+  assert.deepEqual(ok(["F", "AY1", "ER0"], "southern")[1], ["aɪ", "ɑ"]); // fire → "fahr"
+  assert.deepEqual(ok(["R", "AY1", "T"], "southern")[1], ["aɪ"]);
+});
+
+test("Boston and New York: the r after a vowel may be left out", () => {
+  for (const d of ["boston", "newYork"]) {
+    assert.deepEqual(optional(["K", "AA1", "R"], d), [false, false, true]); // car
+    assert.deepEqual(optional(["K", "AA1", "R", "D"], d), [false, false, true, false]); // card
+    assert.deepEqual(optional(["K", "AE1", "R", "IY0"], d), [false, false, false, false]); // carry keeps it
+    assert.deepEqual(optional(["R", "AY1", "T"], d), [false, false, false]); // a first r stays
+    assert.deepEqual(ok(["W", "AO1", "T", "ER0"], d)[3], ["ɝ", "ə"]); // water → "watah"
+  }
+});
+
+// A tiny model with the sounds of "car", to check scoring with an r that may be left out.
+const VOCAB = { "[PAD]": 0, "|": 1, k: 2, "ɑ": 3, "ɹ": 4, "[UNK]": 5 };
+const v = readVocab(VOCAB);
+const frames = (list) =>
+  logSoftmax(list.map((x) => Object.keys(VOCAB).map((k) => (k === (x === "-" ? "[PAD]" : x) ? 8 : 0))));
+const CAR = ["K", "AA1", "R"];
+
+test("car said without the r: red in General American, fine in Boston", () => {
+  const prep = prepare(frames(["k", "k", "-", "ɑ", "ɑ", "ɑ"]), v);
+  const general = scoreWord(prep, targets(CAR, "general"), v);
+  assert.equal(general[2].grade, "red");
+  const boston = scoreWord(prep, targets(CAR, "boston"), v);
+  assert.deepEqual(boston.map((r) => r.grade), ["green", "green", null]);
+  assert.equal(boston[2].dropped, true);
+});
+
+test("car said with the r is still green in Boston", () => {
+  const prep = prepare(frames(["k", "k", "-", "ɑ", "ɑ", "-", "ɹ", "ɹ"]), v);
+  const boston = scoreWord(prep, targets(CAR, "boston"), v);
+  assert.deepEqual(boston.map((r) => r.grade), ["green", "green", "green"]);
+  assert.ok(boston.every((r) => !r.dropped));
+});
+
+// hardware: H AA R D W EH R, here with only "h ɑ d w ɛ ɹ" (the first r left out, the last kept).
+const VOCAB2 = { "[PAD]": 0, "|": 1, h: 2, "ɑ": 3, "ɹ": 4, d: 5, w: 6, "ɛ": 7, "ə": 8, "ɾ": 9, "[UNK]": 10 };
+const v2 = readVocab(VOCAB2);
+const frames2 = (list) =>
+  logSoftmax(list.map((x) => Object.keys(VOCAB2).map((k) => (k === (x === "-" ? "[PAD]" : x) ? 8 : 0))));
+
+test("each r is kept or left out on its own: hardware with one r", () => {
+  const prep = prepare(frames2(["h", "h", "-", "ɑ", "ɑ", "-", "d", "d", "-", "w", "w", "-", "ɛ", "ɛ", "-", "ɹ", "ɹ"]), v2);
+  const result = scoreWord(prep, targets(["HH", "AA1", "R", "D", "W", "EH2", "R"], "boston"), v2);
+  assert.deepEqual(result.map((r) => r.grade), ["green", "green", null, "green", "green", "green", "green"]);
+  assert.equal(result[2].dropped, true);
+  assert.ok(!result[6].dropped);
+});
